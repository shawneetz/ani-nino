{
  "name": "anino-ng-ani",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:prod": "tsx --env-file=.env.supabase scripts/db-migrate.ts",
    "db:validate": "tsx scripts/db-validate.ts",
    "db:seed": "tsx --env-file=.env.supabase scripts/db-seed.ts",
    "snapshot:seed": "tsx scripts/build-snapshot-from-seed.ts",
    "export:snapshot": "tsx --env-file=.env.supabase --require ./scripts/server-only-stub.cjs scripts/export-snapshot.ts",
    "content:publish": "pnpm db:validate && pnpm db:seed && pnpm export:snapshot",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^6.15.0",
    "next": "^15.5.0",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^30.1.3",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3"
  }
}
