# Copy to .env (never commit .env).

# Used by the running app. Role anino_app: SELECT only.
DATABASE_URL=postgres://anino_app:dev-app-pw@localhost:5432/anino

# Used only by migrations, seed scripts, and tests. Never put this in Coolify.
DATABASE_URL_MIGRATE=postgres://anino_owner:dev-owner-pw@localhost:5432/anino
