# .env.example
# Copy to .env and use the Supabase connection strings below for development.
# The same values can be copied to .env.supabase for db:seed, db:migrate:prod,
# and export:snapshot.
# Never commit either file.

# Runtime reader, read-only role.
# For Supabase use the POOLER string (port 6543). A custom role's username
# looks like anino_app.PROJECT_REF
DATABASE_URL=postgres://anino_app.PROJECT_REF:APP_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Owner, used for migrations and seeding only. Never put it in Vercel.
# Use the direct string, or the SESSION pooler (port 5432) if your network has no IPv6.
DATABASE_URL_MIGRATE=postgres://postgres:OWNER_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
