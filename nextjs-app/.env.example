# Supabase. The URL and anon key are safe for the browser. The service key is NOT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub. Use a fine-grained token for this one repo (contents + pull requests).
GITHUB_TOKEN=
GITHUB_REPO=your-name/anino-ng-ani
GITHUB_BASE_BRANCH=main

# Cloudflare Turnstile (server secret)
TURNSTILE_SECRET_KEY=
