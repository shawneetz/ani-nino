# Copy to .env.local (never commit .env.local).

# Used by the running app. Role anino_app: SELECT only.
# This is the only database URL that goes into Coolify.
DATABASE_URL=postgres://anino_app:CHANGE_ME_APP@localhost:5432/anino

# Used only by migrations and seed scripts. Keep out of the app container and Coolify.
DATABASE_URL_MIGRATE=postgres://anino_owner:CHANGE_ME_OWNER@localhost:5432/anino
