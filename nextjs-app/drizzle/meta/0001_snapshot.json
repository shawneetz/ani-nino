      "policies": {},
      "checkConstraints": {
        "pins_id_slug": {
          "name": "pins_id_slug",
          "value": "\"pins\".\"id\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'"
        },
        "pins_start_first_of_month": {
          "name": "pins_start_first_of_month",
          "value": "EXTRACT(DAY FROM \"pins\".\"start_date\") = 1"
        },
        "pins_end_first_of_month": {
          "name": "pins_end_first_of_month",
          "value": "\"pins\".\"end_date\" IS NULL OR EXTRACT(DAY FROM \"pins\".\"end_date\") = 1"
        },
        "pins_end_after_start": {
          "name": "pins_end_after_start",
          "value": "\"pins\".\"end_date\" IS NULL OR \"pins\".\"end_date\" >= \"pins\".\"start_date\""
        },
        "pins_martial_law_window": {
          "name": "pins_martial_law_window",
          "value": "\"pins\".\"layer\" <> 'martial_law' OR (\"pins\".\"start_date\" >= DATE '1972-09-01' AND \"pins\".\"start_date\" <= DATE '1986-02-01')"
        },
        "pins_today_after_martial_law": {
          "name": "pins_today_after_martial_law",
          "value": "\"pins\".\"layer\" <> 'today' OR \"pins\".\"start_date\" >= DATE '1986-03-01'"
        },
        "pins_lead_needs_question": {
          "name": "pins_lead_needs_question",
          "value": "\"pins\".\"status\" <> 'lead' OR \"pins\".\"open_question\" IS NOT NULL"
        },
        "pins_verified_complete": {
          "name": "pins_verified_complete",
          "value": "\"pins\".\"status\" <> 'verified' OR (\"pins\".\"verified_on\" IS NOT NULL AND \"pins\".\"record\" IS NOT NULL AND \"pins\".\"badge\" IS NOT NULL)"
        },
        "pins_primary_not_in_secondary": {
          "name": "pins_primary_not_in_secondary",
          "value": "NOT (\"pins\".\"family\" = ANY(\"pins\".\"secondary_families\"))"
        }
      },
      "isRLSEnabled": false
    },
